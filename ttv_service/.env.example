# TTV Service Configuration
# Production settings for Task 8 integration

# Service Configuration
TTV_SERVICE_HOST=0.0.0.0
TTV_SERVICE_PORT=8002
TTV_SERVICE_WORKERS=4
TTV_DEBUG=false

# BHIV Integration
BHIV_BACKEND_URL=http://192.168.0.121:8001
BHIV_API_KEY=your_bhiv_api_key_here
BHIV_WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration (matching BHIV system)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_agent
REDIS_URL=redis://localhost:6379/0

# Supabase Configuration (for JWT validation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Storage Configuration
STORAGE_BACKEND=supabase  # Options: local, s3, supabase, bhiv_bucket
S3_BUCKET_NAME=ttv-videos
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# BHIV Bucket Integration
BHIV_BUCKET_PATH=bucket
BHIV_STORAGE_BACKEND=supabase

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Content Moderation
CONTENT_MODERATION_ENABLED=true
MAX_SCRIPT_LENGTH=10000
FORBIDDEN_KEYWORDS=violence,hate,explicit,illegal,harmful

# Monitoring and Observability
SENTRY_DSN=https://your-sentry-dsn-here
ENVIRONMENT=production
LOG_LEVEL=INFO

# GPU and Processing Configuration
GPU_MEMORY_LIMIT=8192  # MB
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MINUTES=15
CLEANUP_TEMP_FILES=true

# Video Generation Settings
DEFAULT_VIDEO_STYLE=realistic
DEFAULT_QUALITY=balanced
DEFAULT_FPS=12
MAX_VIDEO_DURATION=120  # seconds
MAX_SCENES_PER_VIDEO=10

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_BURST=5

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30  # seconds
HEALTH_CHECK_TIMEOUT=5    # seconds