# Task-6 Production Configuration - Example
# Copy this file to .env and configure for your environment

# BHIV Integration
BHIV_ENDPOINT=http://192.168.0.121:8001
BHIV_API_KEY=your-api-key-here

# NAS Storage
NAS_PATH=/mnt/nas
NAS_BASE_URL=https://nas.example.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=4
API_TIMEOUT=300

# GPU Configuration
GPU_MEMORY_THRESHOLD=0.8
GPU_TEMPERATURE_THRESHOLD=80

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-production-secret-key-here
JWT_SECRET=your-jwt-secret-here

# Database (if needed)
# DATABASE_URL=postgresql://user:pass@localhost:5432/ttv_db

# Redis (for caching)
# REDIS_URL=redis://localhost:6379

# Monitoring
# PROMETHEUS_PORT=9090
# GRAFANA_URL=http://localhost:3000